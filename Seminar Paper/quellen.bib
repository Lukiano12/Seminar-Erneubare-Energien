@article{NatriumIonenAkkumulator2026,
  title = {{Natrium-Ionen-Akkumulator}},
  year = 2026,
  month = jan,
  journal = {Wikipedia},
  urldate = {2026-02-19},
  abstract = {Der Natrium-Ionen-Akkumulator, englisch sodium-ion battery (abgek\"urzt SIB), dient der Speicherung elektrischer Energie und nutzt dabei Ionen des Alkalimetalls Natrium. Natrium-Ionen-Batterien kommen ohne kritische Rohstoffe aus. Obwohl ihre Energiedichte geringer ist als bei Lithium-Ionen-Akkumulatoren, versprechen Natrium-Ionen-Akkumulatoren diesen gegen\"uber diverse Vorteile wie bessere Umweltbilanz, gr\"o\ss ere Sicherheit, bessere Leistung (auch bei niedrigen Temperaturen) und Nutzung g\"unstiger Rohstoffe, womit zugleich geringere geopolitische Abh\"angigkeit von kritischen Rohstoffen erreicht werden k\"onnte. Daher werden Natrium-Ionen-Akkus intensiv erforscht. Natrium-Ionen-Akkus finden mit Stand 2025 zunehmend Zulauf in den Batteriemarkt, in einzelnen Nischen sind sie Lithium-Ionen-Akkumulatoren bereits \"uberlegen. Erwartet wird, dass sie sich sehr gut f\"ur den Einsatz als Batterie-Speicherkraftwerk eignen und auch bei der Elektromobilit\"at Marktanteile gewinnen werden, insbesondere im g\"unstigen Preissegment und bei Elektroautos mit niedriger bis mittlerer Reichweite.},
